diff --git a/src/server/coa/AscensionClassServiceBridge.h b/src/server/coa/AscensionClassServiceBridge.h
new file mode 100644
index 000000000..e1017a4df
--- /dev/null
+++ b/src/server/coa/AscensionClassServiceBridge.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "AscensionCoATalentData.h"
+#include <string>
+
+class Player;
+
+// Minimal, deliberately narrow bridge into AscensionClassService, which is entirely private to AscensionCompat.cpp (defined inside a
+// file-local anonymous namespace, no other public header). A bot module needs to switch spec and spend a bot's paid (AECost/TECost > 0)
+// Ascension talent points through the same budget-checked, mutually-exclusive-group-aware path a real player's `.localspec` and
+// `.localtalent` commands use, instead of writing PlayerSettings and learnSpell()-ing spells directly, which skips the budget check and the
+// in-memory active-spec bookkeeping that GetActiveSpecialization() depends on.
+// (From mod-coa-playerbots, docs/core-patches.md, "Patch 3".)
+namespace AscensionClassServiceBridge
+{
+    // Mirrors AscensionClassService::SwitchSpecialization(player, specializationId). False if the id is not valid for the player's class.
+    bool SwitchSpecialization(Player* player, uint32 specializationId);
+
+    // Mirrors AscensionClassService::SetTalentRank(player, entry, rank, error) with the budget check on: same validation order, same budget
+    // accounting, same free-choice-group exclusion. False, with `error` filled in, when it is refused (wrong class or spec, level too low,
+    // over budget).
+    bool SetTalentRank(Player* player, AscensionCompatData::CoATalentEntry const& entry, uint32 rank, std::string& error);
+}
